# Porta do servidor
PORT=9511

# Segredo do webhook — vai no CAMINHO da URL que a Evolution chama:
#   https://SEU_DOMINIO/webhook/<WEBHOOK_SEGREDO>
#
# É o que prova que o POST veio da SUA instância. Quem errar o segredo recebe
# 404, e não 401: sem isso, errar o segredo confirmaria que existe um webhook
# ali. Use um valor longo e aleatório, sem "/" nem acento.
#
# ATENÇÃO: diferente do HMAC da Meta, um segredo no caminho prova QUEM chamou,
# mas não que o corpo chegou intacto. O caminho ainda aparece em log de proxy e
# em histórico de navegador. Por isso o webhook TEM de ser HTTPS.
WEBHOOK_SEGREDO=troque_por_um_segredo_longo_e_aleatorio

# Endereço da sua Evolution API, com esquema e porta. Sem barra no fim.
# Em produção: HTTPS. Apontando para http://127.0.0.1:4000 você fala com a
# Evolution de mentira (`npm run dev:evolution`) e roda a conversa inteira sem
# instância conectada e sem número de WhatsApp.
EVOLUTION_URL=http://127.0.0.1:4000

# Chave da Evolution, mandada no cabeçalho `apikey` de cada envio.
# É a AUTHENTICATION_API_KEY global da instalação, ou o token da instância.
EVOLUTION_API_KEY=PREENCHER_APIKEY

# Nome da instância criada na Evolution (o que aparece no /instance/fetchInstances).
# Entra na URL de envio: POST {EVOLUTION_URL}/message/sendText/{EVOLUTION_INSTANCIA}
EVOLUTION_INSTANCIA=PREENCHER_NOME_DA_INSTANCIA

# Token do endpoint interno que muda a situação do chamado (você escolhe).
# Use um valor longo e aleatório: quem tiver esse token pode alterar chamados.
INTERNAL_API_TOKEN=troque_por_um_token_longo_e_aleatorio

# Banco de dados
#
# É um ARQUIVO SQLite, não um servidor: não há host, porta, usuário nem senha —
# e por isso este é o único valor deste bloco. Nada para instalar, nada para
# subir, nada para preencher: o valor abaixo funciona como está.
#
# O caminho relativo é resolvido contra a RAIZ DO PROJETO, e não contra o
# diretório de onde o comando foi rodado (ver src/db/caminho.ts) — é o que faz
# `npm run dev`, `npm run prisma:deploy` e um `npm run retencao` no cron abrirem
# o MESMO arquivo. O diretório é criado se não existir.
#
# NÃO aceita parâmetros na URL (`?algo=1`): o valor inteiro depois do `file:` é
# tratado como nome de arquivo, então a query string viraria parte do nome.
#
# NO SERVIDOR: aponte para o disco persistente, não para dentro da imagem —
# ex. file:/app/dados/whatsapp-suporte.db (ver render.yaml).
DATABASE_URL="file:./dados/whatsapp-suporte.db"

# --- Lock de escrita ---
# Quanto esperar pelo lock antes de devolver SQLITE_BUSY (ms).
#
# Não é pool: SQLite não tem pool, tem UM escritor por banco, e dentro deste
# processo as transações já são serializadas pelo adaptador. Isto vale para
# quando OUTRO processo está escrevendo — o `npm run retencao` do cron, o
# `npm run db:view` do deploy, um `sqlite3` aberto para conferir dado.
# DB_BUSY_TIMEOUT_MS=10000

# --- Opcionais (têm padrão; descomente só para ajustar) ---

# Tamanho máximo do corpo da requisição, em bytes
# BODY_LIMIT_BYTES=262144

# Limite de caracteres por mensagem recebida
# MAX_CARACTERES_MENSAGEM=4096

# Tamanho máximo de UM anexo de chamado, em bytes (padrão 5 MB).
#
# Tem limite próprio, e não o BODY_LIMIT_BYTES acima, porque as duas rotas
# recebem coisas de tamanho incomparável: o webhook da Evolution é um JSON de alguns
# kilobytes, e um print de tela do PDV tem megabytes.
#
# O binário do anexo mora DENTRO do SQLite, então este número decide quão rápido
# o arquivo do banco cresce: 5 MB x anexos por chamado x chamados. Baixar é
# seguro; subir exige olhar o espaço em disco e o tamanho do backup.
#
# A rota recebe o arquivo em base64 dentro do JSON, e o limite de corpo dela é
# calculado a partir daqui (4/3 pela inflação do base64) — não é preciso mexer
# em BODY_LIMIT_BYTES para aceitar anexo maior.
# ANEXO_MAX_BYTES=5242880

# Teto de requisições por minuto no endpoint (proteção contra flood)
# RATE_LIMIT_POR_MINUTO=300

# Confiar no X-Forwarded-For para descobrir o IP do cliente.
# LIGUE se houver um proxy confiável na frente (ngrok, Render, nginx, load
# balancer): sem isso todo request aparece com o IP do proxy e o limite acima
# vira um contador global. NÃO ligue se o processo estiver exposto direto na
# internet - aí qualquer um forja o header e escapa do limite.
# Aceita: true | false | número de hops confiáveis | lista de IPs/CIDRs
# TRUST_PROXY=false

# Teto de mensagens por minuto por telefone (proteção contra abuso)
MSGS_POR_MINUTO_POR_TELEFONE=20

# Redis para os limites POR TELEFONE (o teto acima e o aviso de indisponibilidade).
#
# Vazio = os dois vivem em memória, no processo. É o padrão e é CORRETO com uma
# instância só - que é o que o render.yaml declara hoje.
#
# Com MAIS DE UMA instância, memória deixa de bastar sem nada quebrar: cada
# processo tem a sua contagem e o limite efetivo vira INSTÂNCIAS x o configurado,
# em silêncio. Preencher isto é o que faz os limites valerem para a frota.
# Falha do Redis não desliga o limite: ele volta a valer por instância.
# REDIS_URL=redis://default:senha@host:6379

# Prefixo de toda chave gravada no Redis. Redis gerenciado costuma ser
# compartilhado entre serviços; sem prefixo, dois sistemas que usem o telefone
# como chave se atropelam.
# REDIS_PREFIXO=wa

# Horas de inatividade até a coleta em andamento ser descartada.
# Aceita fração: 0.5 = meia hora (útil para exercitar a expiração sem esperar).
# SESSAO_TTL_HORAS=24

# De quanto em quanto tempo varrer sessões abandonadas do banco. O prazo em si é
# o SESSAO_TTL_HORAS acima; isto é só a frequência da varredura.
# LIMPEZA_SESSOES_MINUTOS=60

# Envio: tentativas imediatas, teto total (imediatas + varredor) e intervalo do varredor
# ENVIOS_TENTATIVAS=3
# ENVIOS_MAX_TENTATIVAS=6
# VARREDOR_INTERVALO_SEGUNDOS=60

# Tempo máximo gasto enviando mensagens DENTRO de uma requisição de webhook,
# somando o lote todo. Quem entrega o webhook desiste de esperar o 200 em poucos
# segundos; o que
# não couber aqui fica pendente e sai pelo varredor.
# ENVIO_SINCRONO_MS=10000

# --- Painel de chamados (quadro que lê estes dados no navegador) ---
# Origens autorizadas a chamar esta API pelo navegador, separadas por vírgula.
# É a origem do PAINEL, não a do bot. Vazio = CORS desligado (a API continua
# funcionando fora do navegador). NUNCA use "*": estas rotas pedem token.
# Abrir o painel como file:// não funciona — a origem vira "null".
PAINEL_ORIGENS=http://127.0.0.1:8511

# Token só do painel. Opcional: sem ele, o painel usa o INTERNAL_API_TOKEN.
# Vale separar porque este token vive no NAVEGADOR de cada atendente, e não num
# servidor: vaza com mais facilidade, e assim dá para revogar só ele.
# PAINEL_TOKEN=troque_por_outro_token_longo_e_aleatorio

# --- Painel: view de cards ---
# A view `chamados_para_cards` é aplicada por `npm run db:view`, e não tem
# variável de ambiente nenhuma: no SQLite não existe usuário nem GRANT, então
# não há a quem conceder SELECT. Rode `db:view` depois de TODA migração —
# migração que mexe em coluna da view exige a view recriada.

# --- Alerta operacional ---
# Webhook (Slack, Discord ou qualquer coletor de JSON) avisado quando a outbox
# DESISTE de entregar - ou seja, quando alguém mandou mensagem e não recebeu
# resposta nenhuma. Vazio = desligado, sobra só o log.
# O alerta NÃO leva telefone nem texto: só o id da mensagem, para achar a linha.
# ALERTA_WEBHOOK_URL=https://hooks.slack.com/services/...
# Janela de coalescência: numa queda longa da Graph API, todas as pendentes
# desistem juntas. Sem isto o canal recebe centenas de avisos iguais.
# ALERTA_INTERVALO_SEGUNDOS=300

# --- Retenção de dados pessoais (LGPD) ---
# 0 ou ausente = desligado, nada é apagado. Esse prazo é uma DECISÃO DO NEGÓCIO:
# o sistema não assume nenhum valor por conta própria. Ver `npm run retencao`.
# RETENCAO_MENSAGENS_DIAS=0
# RETENCAO_CHAMADOS_DIAS=0


# ============================================================
# PAINEL: PORTA, LOGIN E HTTPS
# ============================================================

# Porta do painel de chamados no navegador. O bot fica em PORT (topo do arquivo).
# As duas precisam estar aqui: sem PORT, o bot vai para o padrao 3000 enquanto o
# painel repassa /internal/* para 9511 - os dois no ar, nada acusa erro, e o
# portal responde 502 em toda chamada de API.
PAINEL_PORT=8511

# Injeta o token da API no servidor, em vez de pedi-lo ao atendente. O painel
# abre direto no quadro e o token nunca chega ao navegador.
#
# ATENCAO: sem o login do Entra ligado abaixo, isto deixa o painel ABERTO para
# quem alcancar a porta - inclusive para ler nome, telefone e descricao de
# chamado. So use assim em rede interna ou atras de VPN.
# PAINEL_TOKEN_NO_SERVIDOR=1

# Host em que o painel escuta. Padrao 0.0.0.0 (todas as interfaces). Para deixar
# o painel acessivel SO na propria maquina, use 127.0.0.1.
# PAINEL_HOST=127.0.0.1

# Trava de seguranca: se o painel estiver SEM login (Entra vazio) E com o token
# injetado no servidor (PAINEL_TOKEN_NO_SERVIDOR=1) E escutando fora do loopback,
# ele RECUSA subir - nesse estado qualquer um que alcance a porta le e altera
# chamado sem autenticar. Saidas: ligue o login, use PAINEL_HOST=127.0.0.1, ou -
# se a porta ja esta atras de firewall/VPN e a exposicao e intencional - confirme
# aqui.
# PAINEL_EXPOSICAO_SEM_LOGIN=1

# ------------------------------------------------------------
# Login pelo Microsoft Entra ID
#
# Enquanto as quatro variaveis abaixo estiverem vazias, o painel sobe SEM login.
# Preencher TODAS liga a exigencia de conta da empresa. Preencher so algumas nao
# sobe: e erro fatal, para ninguem ficar sem a protecao que pediu.
#
# No portal.azure.com > Microsoft Entra ID > App registrations > New registration:
#
#   1. Redirect URI, plataforma "Web":  <PAINEL_URL_BASE>/auth/retorno
#      Tem de bater caractere a caractere. O Entra so aceita http:// em
#      localhost - para a rede, e https:// com nome DNS.
#   2. Certificates & secrets > New client secret. Copie o VALUE na hora e
#      anote a validade: quando expirar, o login para de funcionar.
#   3. Enterprise applications > (o app) > Properties > "Assignment required"
#      = Yes, e em Users and groups atribua quem pode entrar. E aqui, e nao no
#      codigo, que se decide quem tem acesso.
#
# Permissoes: as delegadas openid, profile e email ja vem por padrao. Nao e
# preciso consentimento de administrador.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=PREENCHER_SEGREDO_DO_APP
# PAINEL_URL_BASE=https://painel.suaempresa.com.br:8511

# Assina o cookie de sessao. Gere o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar o valor desloga todo mundo na hora - e o jeito de cortar acesso sem
# esperar as sessoes vencerem.
# PAINEL_SESSAO_SEGREDO=

# Duracao da sessao antes de pedir login de novo. Padrao 8 (um turno).
# PAINEL_SESSAO_HORAS=8

# ------------------------------------------------------------
# HTTPS do painel
#
# Necessario para o login: o Entra so aceita redirect URI http em localhost.
# Sem os dois, o painel sobe em HTTP puro.
#
# Peca o certificado do nome DNS do painel a quem cuida da CA interna do
# dominio. Autoassinado funciona, mas todo navegador da rede mostra aviso.
# PAINEL_TLS_CERT=C:\certificados\painel.crt
# PAINEL_TLS_KEY=C:\certificados\painel.key

# ============================================================
# DOCKER COMPOSE (docker-compose.yml)
#
# Nao se aplica ao Windows Server 2016 - la a Evolution roda nativa,
# instalada por servicos/instalar-evolution.ps1, que gera o .env dela
# a partir DESTE arquivo. Ver docs/WA Evolution no Windows.md.
#
# So o `docker compose` le estas variaveis. Rodando fora de conteiner
# (run.bat, npm run dev) elas sao ignoradas, entao um .env unico serve
# aos dois modos.
#
# Repare no que NAO esta aqui: EVOLUTION_URL e DATABASE_URL. No compose
# esses dois sao fixos (`http://evolution:8080` e o volume do SQLite),
# definidos no proprio arquivo — o valor do .env acima vale so para a
# execucao fora de conteiner.
# ============================================================

# Senha do Postgres DA EVOLUTION. Nao e o banco da aplicacao: o bot usa
# SQLite. Obrigatoria — o compose recusa subir sem ela.
POSTGRES_PASSWORD=troque_por_uma_senha_longa_e_aleatoria
# POSTGRES_USER=evolution
# POSTGRES_DB=evolution

# Porta da Evolution NO HOST. Dentro da rede do compose ela e sempre 8080.
# Mude se a 8080 ja estiver ocupada na maquina.
# EVOLUTION_PORT=8080

# Como a Evolution se enxerga. Nao muda nada na conversa; aparece nas
# respostas da API dela e em QR Code servido por link.
# EVOLUTION_SERVER_URL=http://localhost:8080
