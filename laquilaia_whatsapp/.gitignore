MANIFEST

# Artefatos de build do setuptools, presos a backend/.
#
# Sem o prefixo, `lib/` casa qualquer diretório com esse nome em qualquer
# profundidade — e engoliu `frontend/lib/` inteiro (o cliente HTTP, os tokens
# e as constantes), que ficou fora do repositório sem ninguém notar até a
# stack subir num clone limpo. O mesmo valeria para `build/`, `dist/` e `var/`.
backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
backend/pip-wheel-metadata/
backend/share/python-wheels/

