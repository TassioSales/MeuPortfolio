{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  // Ferramentas de desenvolvimento (Graph de mentira e simulador da Meta) não vão
  // para o build de produção. Elas continuam sendo checadas pelo `npm run
  // typecheck`, que usa o tsconfig.test.json.
  "exclude": ["src/dev"]
}
