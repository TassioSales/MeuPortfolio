# ========== DATABASE (PostgreSQL) ==========
# Database connection details for PostgreSQL
# Default: local development database
# Change DB_PASSWORD to a strong password for production!
DB_USER=laquilaia
DB_PASSWORD=laquilaia_dev_pwd
DB_NAME=laquilaia_db
DB_PORT=5432
DATABASE_URL=postgresql://laquilaia:laquilaia_dev_pwd@postgres:5432/laquilaia_db

# ========== REDIS (Caching & Queue) ==========
# Redis connection for message queue and conversation history caching
# Used by: memory_service for conversation history caching
# Default: local development Redis
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_CACHE_TTL=3600
# REDIS_PASSWORD=your-redis-password (uncomment for production)

# ========== API & SECURITY ==========
# API configuration and security settings
# SECRET_KEY: Used for JWT token signing. MUST be changed in production!
# ALGORITHM: JWT signing algorithm (HS256 recommended)
# ACCESS_TOKEN_EXPIRE_MINUTES: How long access tokens are valid (in minutes)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_PORT=8000

# ========== LOGGING & DEBUGGING ==========
# Control logging verbosity and debug mode
# DEBUG=True enables automatic server reload and detailed error messages
# LOG_LEVEL: CRITICAL, ERROR, WARNING, INFO, DEBUG
DEBUG=False
LOG_LEVEL=INFO

# ========== AI / LLM (Claude Integration) ==========
# Anthropic Claude API configuration
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY: Your Anthropic API key (starts with sk-ant-)
# CLAUDE_MODEL: The Claude model to use (recommended: claude-sonnet-5)
# TEMPERATURE: Response creativity (0=deterministic, 1=random). Default: 0.7
# MAX_TOKENS: Maximum tokens per response. Default: 1024
# LLM_MAX_CALLS_PER_MINUTE: Rate limit for API calls (default: 60)
# LLM_MAX_TOKENS_PER_MINUTE: Rate limit for tokens (default: 40000)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-5
TEMPERATURE=0.7
MAX_TOKENS=1024
LLM_MAX_CALLS_PER_MINUTE=60
LLM_MAX_TOKENS_PER_MINUTE=40000

# ========== AI / LLM (provedor de reserva) ==========
# Gemini assume quando o Claude falha — e assume tudo quando não há
# ANTHROPIC_API_KEY, o que permite rodar só com o Gemini.
# Chave: https://aistudio.google.com/apikey
# Deixe vazio para desligar a reserva: aí o erro do Claude sobe como sempre,
# em vez de virar uma resposta de outro modelo em silêncio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ========== WHATSAPP / EVOLUTION API ==========
# Evolution API configuration for WhatsApp Business integration
# Evolution API Docs: https://doc.evolution-api.com/
# EVOLUTION_API_URL: URL to Evolution API server
# EVOLUTION_API_KEY: Your Evolution API authentication key
# EVOLUTION_INSTANCE_NAME: Name of the WhatsApp instance (e.g., "laquilaia")
# EVOLUTION_WEBHOOK_URL: Webhook URL that Evolution will call (backend must be accessible)
EVOLUTION_API_URL=http://evolution:4000
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=laquilaia
EVOLUTION_WEBHOOK_URL=http://localhost:8000/api/v1/webhook/messages
# WEBHOOK_SECRET: segredo compartilhado do HMAC-SHA256 do webhook.
# Obrigatório em produção — sem ele o endpoint recusa as requisições
# (com DEBUG=true fica aberto, só para desenvolvimento local).
WEBHOOK_SECRET=

# ========== FRONTEND ==========
# Frontend-specific configuration
# FRONTEND_PORT: Host port mapped to the Next.js dev server
# NEXT_PUBLIC_API_URL: Backend API URL (visible to browser)
# NEXT_PUBLIC_WS_URL: WebSocket URL for real-time updates
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ========== CORS & EXTERNAL ACCESS ==========
# CORS configuration for cross-origin requests
# Comma-separated list of allowed origins
# Default: allows localhost (development only)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ========== DEPLOYMENT & ENVIRONMENT ==========
# Environment type: development, staging, production
# Used for conditional behavior and logging
ENVIRONMENT=development

# ========== OPTIONAL: EXTERNAL SERVICES ==========
# These are optional and can be configured later

# Sentry (Error tracking) - Leave empty to disable
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Slack Notifications - Leave empty to disable
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
