# ========== DATABASE (PostgreSQL) ==========
# Database connection details for PostgreSQL
# Default: local development database
# Change DB_PASSWORD to a strong password for production!
DB_USER=laquilaia
DB_PASSWORD=laquilaia_dev_pwd
DB_NAME=laquilaia_db
DB_PORT=5432
DATABASE_URL=postgresql://laquilaia:laquilaia_dev_pwd@postgres:5432/laquilaia_db

# ========== REDIS (Caching & Queue) ==========
# Redis connection for message queue and conversation history caching
# Used by: memory_service for conversation history caching
# Default: local development Redis
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
REDIS_CACHE_TTL=3600
# REDIS_PASSWORD=your-redis-password (uncomment for production)

# ========== API & SECURITY ==========
# API configuration and security settings
# SECRET_KEY: Used for JWT token signing. MUST be changed in production!
# ALGORITHM: JWT signing algorithm (HS256 recommended)
# ACCESS_TOKEN_EXPIRE_MINUTES: How long access tokens are valid (in minutes)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_PORT=8000

# ========== LOGGING & DEBUGGING ==========
# Control logging verbosity and debug mode
# DEBUG=True enables automatic server reload and detailed error messages
# LOG_LEVEL: CRITICAL, ERROR, WARNING, INFO, DEBUG
DEBUG=False
LOG_LEVEL=INFO

# ========== AI / LLM (Claude Integration) ==========
# Anthropic Claude API configuration
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY: Your Anthropic API key (starts with sk-ant-)
# CLAUDE_MODEL: The Claude model to use (recommended: claude-sonnet-5)
# TEMPERATURE: Response creativity (0=deterministic, 1=random). Default: 0.7
# MAX_TOKENS: Maximum tokens per response. Default: 1024
# LLM_MAX_CALLS_PER_MINUTE: Rate limit for API calls (default: 60)
# LLM_MAX_TOKENS_PER_MINUTE: Rate limit for tokens (default: 40000)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-5
TEMPERATURE=0.7
MAX_TOKENS=1024
LLM_MAX_CALLS_PER_MINUTE=60
LLM_MAX_TOKENS_PER_MINUTE=40000

# ========== AI / LLM (provedor de reserva) ==========
# Gemini assume quando o Claude falha — e assume tudo quando não há
# ANTHROPIC_API_KEY, o que permite rodar só com o Gemini.
# Chave: https://aistudio.google.com/apikey
# Deixe vazio para desligar a reserva: aí o erro do Claude sobe como sempre,
# em vez de virar uma resposta de outro modelo em silêncio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Modelo da transcricao de audio. Vazio usa o GEMINI_MODEL.
# `gemini-flash-lite-latest` transcreveu igual em um terco do tempo
# num relato de teste, mas com fala limpa — audio de rua nao foi medido.
GEMINI_TRANSCRICAO_MODEL=

# ========== PARECER JURÍDICO ==========
# A análise interna do caso, que só o escritório lê (ver legal_analyst.py).
# ANALISE_JURIDICA_ENABLED=false desliga e economiza uma chamada por lead.
#
# O parecer pode rodar num modelo mais forte que o atendimento: são frases
# curtas de WhatsApp de um lado, e uma peça de raciocínio lida antes de decidir
# o caso do outro. Uma chamada por lead qualificado, então o modelo caro sai
# barato aqui.
#
# São dois campos porque o parecer também cai para a reserva, e um id de modelo
# não atravessa provedores. Vazio = o mesmo modelo do atendimento.
#
# Atenção ao lado do Gemini: `gemini-pro-latest` responde 429 com "limit: 0" na
# camada gratuita — o modelo aparece em /models mas não tem cota nenhuma sem
# faturamento ativo. Sem billing, deixe vazio ou use gemini-flash-latest, que
# é o que dá para rodar.
ANALISE_JURIDICA_ENABLED=true

ANALISE_CLAUDE_MODEL=claude-opus-5
ANALISE_GEMINI_MODEL=

# Piso, em reais, a partir do qual o caso comporta o trabalho do escritório.
# O parecer estima uma faixa e compara com o **piso** dela, não com o valor
# provável — caso que só compensa no melhor cenário não compensa.
# Isto etiqueta o caso para o advogado conferir; não descarta ninguém sozinho.
CASO_VALOR_MINIMO=15000

# ========== WHATSAPP / EVOLUTION API ==========
# Evolution API configuration for WhatsApp Business integration
# Evolution API Docs: https://doc.evolution-api.com/
# EVOLUTION_API_URL: URL to Evolution API server
# EVOLUTION_API_KEY: Your Evolution API authentication key
# EVOLUTION_INSTANCE_NAME: Name of the WhatsApp instance (e.g., "laquilaia")
# EVOLUTION_WEBHOOK_URL: Webhook URL that Evolution will call (backend must be accessible)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE_NAME=laquilaia
EVOLUTION_WEBHOOK_URL=http://localhost:8000/api/v1/webhook/messages
# WEBHOOK_SECRET: segredo compartilhado do HMAC-SHA256 do webhook.
# Obrigatório em produção — sem ele o endpoint recusa as requisições
# (com DEBUG=true fica aberto, só para desenvolvimento local).
WEBHOOK_SECRET=
# WEBHOOK_STATIC_TOKEN: alternativa ao HMAC, para quem não assina o corpo.
# A Evolution API é um desses casos: ela só repassa cabeçalhos fixos, então
# com HMAC ela seria recusada em toda mensagem. Configure o mesmo valor aqui e
# no cabeçalho `x-webhook-token` da instância da Evolution.
# É mais fraco de propósito: prova que quem chamou conhece o segredo, mas não
# que o corpo chegou íntegro nem que a requisição não é uma repetição.
WEBHOOK_STATIC_TOKEN=
# EVOLUTION_DEFAULT_AGENT_ID: qual agente atende o WhatsApp. A Evolution não
# sabe que agentes existem, então sem isto todo webhook real é recusado com
# "Missing agent_id". Pegue o id em /dashboard/agents depois de criar o agente.
EVOLUTION_DEFAULT_AGENT_ID=
# EVOLUTION_PORT: porta da Evolution no host. EVOLUTION_SERVER_URL é como ela
# se enxerga de fora (usada nos QR codes e links do Manager).
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080

# ========== FRONTEND ==========
# Frontend-specific configuration
# FRONTEND_PORT: Host port mapped to the Next.js dev server
# NEXT_PUBLIC_API_URL: Backend API URL (visible to browser)
# O WebSocket não tem variável própria: `useAgentEvents` deriva a URL da
# NEXT_PUBLIC_API_URL trocando http por ws. Havia uma NEXT_PUBLIC_WS_URL
# aqui que nenhum código lia — configurá-la não mudava nada, e apontar as
# duas para lugares diferentes daria uma inconsistência silenciosa.
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ========== CORS & EXTERNAL ACCESS ==========
# CORS configuration for cross-origin requests
# Comma-separated list of allowed origins
# Default: allows localhost (development only)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ========== DEPLOYMENT & ENVIRONMENT ==========
# Environment type: development, staging, production
# Used for conditional behavior and logging
ENVIRONMENT=development

# ========== OPTIONAL: EXTERNAL SERVICES ==========
# These are optional and can be configured later

# Sentry (Error tracking) - Leave empty to disable
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Slack Notifications - Leave empty to disable
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
